# ScholarHub Environment Variables
# Copy this file to .env and fill in all values

# ── Anthropic Claude API (required for all AI features) ──────
# Get your key at: https://console.anthropic.com
GEMINI_API_KEY=your-gemini-api-key-from-aistudio

# ── Supabase (required for auth, database, storage) ──────────
# Get these from: https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Optional: Resend SMTP (eliminates Supabase email rate limits) ────
# Configure in Supabase dashboard → Authentication → SMTP Settings
# Host: smtp.resend.com | Port: 465 | Username: resend | Password: your key below
# Get your key at: https://resend.com
# RESEND_API_KEY=re_your-resend-key-here


# (The WhatsApp UI works without these — only actual SMS delivery needs it)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── EmailJS (free OTP email delivery — no backend needed) ─────
# Setup takes ~5 minutes at https://emailjs.com (free: 200 emails/month)
#
# Step 1 — Create account at https://emailjs.com
# Step 2 — Add an Email Service (Gmail / Outlook / Yahoo)
# Step 3 — Create an Email Template with these variables:
#            {{to_email}}   recipient email address
#            {{to_name}}    recipient name (part before @)
#            {{otp_code}}   the 6-digit OTP
#            {{expires_in}} "10 minutes"
#            {{app_name}}   "ScholarHub"
# Step 4 — Copy the IDs below from your EmailJS dashboard
#
# If these are left blank, OTP will be shown on-screen (dev mode only).
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
